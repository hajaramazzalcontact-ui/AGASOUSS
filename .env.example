# Copiez ce fichier en .env et adaptez les valeurs.
# Mode démo : données fictives clairement identifiées.
AZUL_MODE=demo

# IA optionnelle. Sans clé, les moteurs locaux prennent le relais.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Clé de chiffrement des champs sensibles (générée automatiquement si vide).
# Production : conservez cette valeur hors du dépôt.
AZUL_FERNET_KEY=

# Compte administrateur de démonstration.
AZUL_ADMIN_EMAIL=admin@azul.local
AZUL_ADMIN_PASSWORD=AzulDemo2026!
