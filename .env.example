# AZUL AGADIR - Configuration locale
# Copie ce fichier en .env et renseigne tes propres valeurs

# API Anthropic (Claude IA)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Clé secrète Streamlit (sessions et cache)
STREAMLIT_CLIENT_SCRIPT_RUN_ON_SAVE=false
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Base de données
DATABASE_URL=sqlite:///./azul_agadir.db

# Environnement
ENVIRONMENT=development
DEBUG=true

# Données de démonstration
USE_DEMO_DATA=true
DEMO_MODE=true

# API Météo (gratuit)
WEATHER_API_KEY=free  # Open-Meteo ne nécessite pas de clé

# Email (optionnel pour plus tard)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=xxx@gmail.com
SMTP_PASSWORD=xxxxxxx

# WhatsApp (optionnel pour plus tard)
WHATSAPP_API_KEY=

# Paiement (optionnel pour plus tard)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Région et langue par défaut
DEFAULT_LANGUAGE=fr
DEFAULT_CURRENCY=MAD
TIMEZONE=Africa/Casablanca
